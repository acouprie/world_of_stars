<% if active_missions.any? %>
  <div class="px-5 pb-6 flex flex-col gap-3">
    <p class="scifi-text text-[11px] uppercase tracking-wider text-text-muted"><%= t("explorations.active_section") %></p>
    <% active_missions.each do |mission| %>
      <%= render "explorations/active_mission", mission: mission %>
    <% end %>
  </div>
<% end %>
