<% provide(:title, "World of Stars — #{t('explorations.page_title')}") %>

<%= render 'planets/resources_bar', planet: @planet %>

<div class="scifi-text flex items-center justify-between gap-3 px-5 py-4">
  <div class="flex items-center gap-3">
    <%= link_to planet_path(@planet), class: "text-[11px] text-text-subtle hover:text-text transition-colors" do %>
      ← <%= @planet.name %>
    <% end %>
    <span class="text-text-subtle opacity-30">/</span>
    <span class="text-[13px] text-text"><%= t("explorations.page_title") %></span>
  </div>
  <span class="text-[11px] text-text-muted">
    <%= @active_missions.count %> / <%= Explorations::MAX_SIMULTANEOUS_EXPLORATIONS %> <%= t("explorations.missions_active") %>
  </span>
</div>

<%# Active missions %>
<div id="active-missions-section">
  <%= render "explorations/active_missions_section", active_missions: @active_missions %>
</div>

<%# Mission history %>
<% if @completed_missions.any? %>
  <div class="px-5 pb-8 flex flex-col gap-3">
    <p class="scifi-text text-[11px] uppercase tracking-wider text-text-muted"><%= t("explorations.history_section") %></p>
    <% @completed_missions.each do |mission| %>
      <%
        force     = mission.force_snapshot
        losses    = mission.losses_snapshot || {}
        target    = mission.target_planet
        survivors = force.each_with_object({}) do |(type, sent), acc|
          lost = losses[type] || losses[type.to_s] || 0
          acc[type] = [sent - lost, 0].max
        end
      %>
      <div class="rounded border p-3 flex flex-col gap-2" style="border-color: var(--color-border);">
        <div class="flex items-start justify-between gap-2">
          <div class="flex flex-col gap-0.5">
            <span class="scifi-text text-[12px] text-text">
              <%= target.name %>
              <span class="text-text-muted text-[10px]">[ <%= target.coord_x %> : <%= target.coord_y %> ]</span>
            </span>
            <span class="scifi-text text-[10px] text-text-muted">
              <%= l(mission.started_at, format: :short) %>
            </span>
          </div>
          <% if mission.exploration_points > 0 %>
            <span class="scifi-text text-[11px]" style="color: var(--color-quantum);">+<%= mission.exploration_points %> XP</span>
          <% end %>
        </div>

        <%# Force vs survivants %>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] scifi-text">
          <% survivors.each do |type, count| %>
            <% sent = force[type] || force[type.to_s] || 0 %>
            <span class="<%= count < sent ? 'text-alert' : 'text-text-muted' %>">
              <%= t("units.types.#{type}", default: type.to_s.humanize) %>: <%= count %>/<%= sent %>
            </span>
          <% end %>
        </div>

        <%# Resources gained %>
        <% if mission.metal_gained.to_i > 0 || mission.food_gained.to_i > 0 || mission.thorium_gained.to_i > 0 %>
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] scifi-text">
            <% if mission.metal_gained.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/metal.png", alt: t("resources.metal"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.metal_gained) %></span>
              </span>
            <% end %>
            <% if mission.food_gained.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/food.png", alt: t("resources.food"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.food_gained) %></span>
              </span>
            <% end %>
            <% if mission.thorium_gained.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/thorium.png", alt: t("resources.thorium"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.thorium_gained) %></span>
              </span>
            <% end %>
          </div>
        <% end %>

        <%# Narrative stub %>
        <p class="scifi-text text-[10px] text-text-subtle italic">
          <%= mission.narrative_report || t("explorations.narrative_pending") %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>

<% if @active_missions.empty? && @completed_missions.empty? %>
  <div class="flex flex-col items-center justify-center gap-2 py-12 text-center px-5">
    <span class="text-2xl opacity-30">◎</span>
    <span class="scifi-text text-[12px] text-text-subtle"><%= t("explorations.no_missions_yet") %></span>
  </div>
<% end %>
