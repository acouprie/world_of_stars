<% provide(:title, "World of Stars — #{t('combats.page_title')}") %>

<%= render 'planets/resources_bar', planet: @planet %>

<div class="scifi-text flex items-center justify-between gap-3 px-5 py-4">
  <div class="flex items-center gap-3">
    <%= link_to planet_path(@planet), class: "text-[11px] text-text-subtle hover:text-text transition-colors" do %>
      ← <%= @planet.name %>
    <% end %>
    <span class="text-text-subtle opacity-30">/</span>
    <span class="text-[13px] text-text"><%= t("combats.page_title") %></span>
  </div>
</div>

<% if @target_planet %>
  <div class="px-5 pb-6">
    <%= render "combats/launch_form", target_planet: @target_planet %>
  </div>
<% end %>

<%# Outgoing missions %>
<div id="outgoing-missions-section">
  <%= render "combats/outgoing_missions_section", outgoing_traveling: @outgoing_traveling %>
</div>

<%# Mission history %>
<% if @completed_missions.any? %>
  <div class="px-5 pb-8 flex flex-col gap-3">
    <p class="scifi-text text-[11px] uppercase tracking-wider text-text-muted"><%= t("combats.history_section") %></p>
    <% @completed_missions.each do |mission| %>
      <%
        is_attacker      = mission.planet_id == @planet.id
        opponent         = is_attacker ? mission.target_planet.name : @planet.name
        direction_key    = is_attacker ? "combats.direction_attack" : "combats.direction_defense"
        own_losses       = is_attacker ? mission.attacker_losses : mission.defender_losses
        enemy_losses     = is_attacker ? mission.defender_losses : mission.attacker_losses
        own_force        = is_attacker ? mission.attacker_force : mission.defender_force_snapshot
        own_survivors    = own_force.each_with_object({}) { |(type, sent), h|
          survivors = sent.to_i - own_losses.fetch(type, 0).to_i
          h[type] = survivors if survivors > 0
        }
        xp_gained        = is_attacker ? mission.attacker_xp_gained : mission.defender_xp_gained
        pillaged         = is_attacker && [mission.metal_pillaged, mission.food_pillaged, mission.thorium_pillaged].any? { |v| v.to_i > 0 }
      %>
      <div class="rounded border p-3 flex flex-col gap-2" style="border-color: var(--color-border);">
        <div class="flex items-start justify-between gap-2">
          <div class="flex flex-col gap-0.5">
            <span class="scifi-text text-[12px] text-text"><%= t(direction_key, planet: opponent) %></span>
            <span class="scifi-text text-[10px] text-text-muted">
              <%= l(mission.started_at, format: :short) %> · <%= t("combats.rounds") %> <%= mission.rounds_count %>
            </span>
          </div>
          <div class="flex flex-col items-end gap-0.5">
            <span class="scifi-text text-[11px] <%= mission.outcome == 'attacker_wins' ? 'text-quantum' : (mission.outcome == 'attacker_retreat' ? 'text-warning' : 'text-alert') %>">
              <%= t("combats.outcome.#{mission.outcome}", default: mission.outcome) %>
            </span>
            <% if xp_gained.to_i > 0 %>
              <span class="scifi-text text-[11px] text-military">+<%= xp_gained %> <%= t("combats.xp_gained") %></span>
            <% end %>
          </div>
        </div>

        <%# Losses %>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] scifi-text">
          <% if own_losses.present? %>
            <span class="text-text-muted">
              <%= t(is_attacker ? "combats.attacker_losses" : "combats.defender_losses") %>:
              <% own_losses.each do |type, count| %>
                <span class="text-alert"><%= unit_name(type) %> -<%= count %></span>
              <% end %>
            </span>
          <% end %>
          <% if enemy_losses.present? %>
            <span class="text-text-muted">
              <%= t(is_attacker ? "combats.defender_losses" : "combats.attacker_losses") %>:
              <% enemy_losses.each do |type, count| %>
                <span class="text-quantum"><%= unit_name(type) %> -<%= count %></span>
              <% end %>
            </span>
          <% end %>
        </div>

        <%# Troops sent and own survivors %>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] scifi-text">
          <% if mission.attacker_force.present? %>
            <span class="text-text-muted">
              <%= t("combats.troops_sent") %>:
              <% mission.attacker_force.each do |type, count| %>
                <span class="text-text"><%= unit_name(type) %> <%= count %></span>
              <% end %>
            </span>
          <% end %>
          <% if own_survivors.present? %>
            <span class="text-text-muted">
              <%= t(is_attacker ? "combats.attacker_survivors" : "combats.defender_survivors") %>:
              <% own_survivors.each do |type, count| %>
                <span class="text-quantum"><%= unit_name(type) %> <%= count %></span>
              <% end %>
            </span>
          <% end %>
        </div>

        <%# Resources pillaged %>
        <% if pillaged %>
          <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] scifi-text">
            <% if mission.metal_pillaged.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/metal.png", alt: t("resources.metal"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.metal_pillaged) %></span>
              </span>
            <% end %>
            <% if mission.food_pillaged.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/food.png", alt: t("resources.food"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.food_pillaged) %></span>
              </span>
            <% end %>
            <% if mission.thorium_pillaged.to_i > 0 %>
              <span class="flex items-center gap-1">
                <%= image_tag "icons/thorium.png", alt: t("resources.thorium"), class: "h-3 w-3" %>
                <span class="text-text">+<%= number_with_delimiter(mission.thorium_pillaged) %></span>
              </span>
            <% end %>
          </div>
        <% end %>

        <%# Narrative stub %>
        <p class="scifi-text text-[10px] text-text-subtle italic">
          <%= mission.narrative_report || t("combats.narrative_pending") %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>

<% if @outgoing_traveling.empty? && @completed_missions.empty? && @target_planet.nil? %>
  <div class="flex flex-col items-center justify-center gap-2 py-12 text-center px-5">
    <span class="text-2xl opacity-30">⚔</span>
    <span class="scifi-text text-[12px] text-text-subtle"><%= t("combats.no_missions_yet") %></span>
  </div>
<% end %>
