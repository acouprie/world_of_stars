<% if outgoing_traveling.any? %>
  <div class="px-5 pb-6 flex flex-col gap-3">
    <p class="scifi-text text-[11px] uppercase tracking-wider text-text-muted"><%= t("combats.active_section") %></p>
    <% outgoing_traveling.each do |mission| %>
      <%= render "combats/outgoing_mission", mission: mission %>
    <% end %>
  </div>
<% end %>
